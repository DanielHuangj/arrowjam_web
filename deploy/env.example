# 复制为 deploy.env 并填写实际值（Windows: 复制 env.example 为 deploy.env）
DEPLOY_HOST=yunwei@your-server-ip
DEPLOY_PATH=/data/yunwei/arrawjam
# 上传后 smoke test 访问地址（含协议与端口，优先于 DOMAIN）
SITE_URL=http://arrowjam.farfieldgames.com:18080
# 关卡编辑器（update-editor.ps1）
EDITOR_DEPLOY_PATH=/data/yunwei/arroweditor
# 编辑器外网访问地址（smoke test 用；未设置则跳过 HTTP 验收）
EDITOR_SITE_URL=http://arrowjam.farfieldgames.com:18081
# 仅首次部署配置 Nginx/HTTPS 时使用（日常 update 可忽略）
DOMAIN=your-domain.com
